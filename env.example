# Copy to .env (shared values) or ~/.nocturne.env (per machine; overrides .env). Bash syntax, no spaces around =.

MODEL=/path/to/Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Per machine (put in ~/.nocturne.env). Default: ~/dev/llama.cpp if built there, else third_party/llama.cpp.
# LLAMA_DIR=$HOME/dev/llama.cpp
# BACKEND=metal|cuda|vulkan|cpu
# BIND=<lan, tailscale or relay-facing ip>      worker bind address; see docs/he/CONNECTIVITY.md

# Optional
# RPC_PORT=50052
# CLI_EXTRA="--verbose --log-prefix --log-timestamps"
# export GGML_RPC_DEBUG=1
